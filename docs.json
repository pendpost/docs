{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "pendpost",
  "description": "Agent-operated social ops with a human approval gate. Local-first, MCP-native.",
  "colors": {
    "primary": "#0d9488",
    "light": "#5eead4",
    "dark": "#0f766e"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "contextual": {
    "options": ["copy", "view", "mcp"]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "introduction",
              "quickstart",
              "mock-mode"
            ]
          },
          {
            "group": "Credentials",
            "pages": [
              "credentials/meta",
              "credentials/linkedin",
              "credentials/youtube",
              "credentials/x",
              "credentials/telegram",
              "credentials/discord",
              "credentials/reddit",
              "credentials/pinterest",
              "credentials/tiktok",
              "credentials/mastodon",
              "credentials/nostr",
              "credentials/wordpress",
              "credentials/ghost",
              "credentials/gbp"
            ]
          },
          {
            "group": "Interfaces",
            "pages": [
              "mcp-server"
            ]
          },
          {
            "group": "How it works",
            "pages": [
              "architecture",
              "approval-and-circuit-breakers",
              "brand-lint",
              "localization"
            ]
          },
          {
            "group": "Scheduling and hosting",
            "pages": [
              "scheduling",
              "always-on"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://pendpost.com"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/pendpost/pendpost"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/pendpost/pendpost"
    }
  },
  "redirects": [
    { "source": "/getting-started/workspace/organization-settings", "destination": "/quickstart" },
    { "source": "/getting-started/integrations/developer/webhooks", "destination": "/mcp-server" },
    { "source": "/support/account-data/export-data", "destination": "/introduction" }
  ]
}
